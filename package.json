{
  "name": "datafordeler-dar-mcp",
  "version": "0.1.1",
  "mcpName": "io.github.aneal99/datafordeler-dar-mcp",
  "description": "MCP server for Danish addresses from Danmarks Adresseregister (DAR) on Datafordeleren. The replacement for DAWA, which closed on 1 October 2026.",
  "type": "module",
  "bin": {
    "datafordeler-dar-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/normalise.test.mjs test/server.test.mjs",
    "test:live": "npm run build && node test/run-live.mjs",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "denmark",
    "danmark",
    "addresses",
    "adresser",
    "dar",
    "dawa",
    "datafordeler",
    "datafordeleren",
    "geocoding"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aneal99/datafordeler-dar-mcp.git"
  },
  "homepage": "https://github.com/aneal99/datafordeler-dar-mcp#readme",
  "bugs": {
    "url": "https://github.com/aneal99/datafordeler-dar-mcp/issues"
  },
  "author": "Aneal Rege"
}
